#include <behaviors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_U_SCORE      LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

/ {
    combos {
        compatible = "zmk,combos";

        Eisu {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <21 22>;
            layers = <0>;
            timeout-ms = <100>;
        };

        Kana {
            bindings = <&kp INT_KATAKANAHIRAGANA>;
            key-positions = <27 28>;
            layers = <0>;
            timeout-ms = <100>;
        };

        LeftClick {
            bindings = <&mkp LCLK>;
            key-positions = <16 17>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <100>;
        };

        RightClick {
            bindings = <&mkp RCLK>;
            key-positions = <17 18>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <100>;
        };

        MiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <18 16>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <100>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <100>;
        };

        Capsword {
            bindings = <&caps_word>;
            key-positions = <13 16>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        Escape {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <100>;
        };

        DoubleQuote {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <7 8>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <100>;
        };

        Semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <6 7>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <100>;
        };

        Colon {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <26 27>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            timeout-ms = <100>;
        };

        Scroll {
            bindings = <&mo 3>;
            key-positions = <16 17 18>;
            layers = <0>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <13 12>;
            layers = <0>;
            timeout-ms = <100>;
        };

        Delete {
            bindings = <&kp DEL>;
            key-positions = <2 3>;
            layers = <0>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E        &kp R        &kp T                    &kp Y          &kp U          &kp I        &kp O          &kp P
&kp A      &kp S         &kp D        &kp F        &kp G                    &kp H          &kp J          &kp K        &kp L          &lt 3 MINUS
&kp Z      &kp X         &kp C        &kp V        &kp B        &kp N       &kp M          &kp COMMA      &kp DOT      &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &lt 1 SPACE  &lt 3 MINUS  &kp INT_MUHENKAN         &kp INT_KATAKANAHIRAGANA  &kp BACKSPACE  &lt 2 ENTER  &kp RIGHT_ALT  &kp DEL
            >;
        };

        layer_1 {
            bindings = <
&none   &none   &none   &none   &none  &kp EQUAL  &kp LS(LEFT_BRACKET)  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp LEFT_BRACKET
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp RS(NUMBER_6)  &kp RS(NUMBER_7)  &kp RS(NUMBER_8)  &kp RS(NUMBER_9)  &kp RS(INT1)
&kp SLASH  &kp LS(SINGLE_QUOTE)  &kp MINUS  &kp LS(SEMICOLON)  &none  &kp RS(INT3)  &kp LS(EQUAL)  &kp RS(RIGHT_BRACKET)  &kp RS(BACKSLASH)
&kp INT3  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &kp F12
            >;
        };

        layer_2 {
            bindings = <
&kp F1  &kp F4  &kp F3  &kp F2  &kp F5        &kp F6  &kp F10  &kp F7  &kp F8  &kp F9
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp SLASH  &kp LS(SINGLE_QUOTE)  &kp MINUS  &kp LS(SEMICOLON)  &none  &kp F11  &kp F12  &kp COMMA  &kp DOT  &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp JP_U_SCORE
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &none  &none  &none                   &none  &none  &none  &none  &kp END
&mo 4  &trans  &trans  &trans  &trans      &kp HOME  &kp LEFT  &kp UP  &kp RIGHT  &none
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none     &none  &none  &kp DOWN  &none  &none
&trans  &trans  &trans  &kp DELETE  &trans        &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans         &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans         &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &bootloader    &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans    &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans    &trans
            >;
        };
    };
};
